---
import MainLayout from '../../layouts/Mainlayout.astro';

import MainCourses from '../../components/maincourses/MainCourses.jsx';

const pageTitle = "Courses | Haasutech AI";
const pageDescription = "Explore AI, Data Science, and DSA courses by industry experts and IITians.";
const ogImage = "/ai-og.png";
---

<head>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="keywords" content="AI courses in Noida, data science courses in Bangalore, free AI internship, best data science institute, AI training for students, No.1 AI training in Noida, Haasutech AI courses, data science internship, machine learning course with internship, free data science training, IIT AI mentors, AI certification Noida, internship for BTech students, online AI course India, job-ready data science programs, best AI course for freshers, Python AI course, deep learning internship, AI bootcamp Bangalore, student-friendly AI programs, AI placement assistance, Noida internship programs, Bangalore AI classes, learn AI from scratch" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />

  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "AI & Machine Learning Certification",
  "description": "Learn AI and ML from IITians with placement support.",
  "provider": {
    "@type": "Organization",
    "name": "Haasutech AI",
    "sameAs": "https://haasutech.in"
  }
}
</script>

</head>

<MainLayout>
  <MainCourses client:load />
</MainLayout>
