---

import MainLayout from '../layouts/Mainlayout.astro';
import HomePage from '../components/HomePage.jsx';
import { Fragment } from 'astro/jsx-runtime';
---

<MainLayout>
  <Fragment slot="head">
    <title>Haasutech AI - Learn AI from IITians</title>
    <meta name="description" content="Master AI, ML, DSA from IITians & industry experts. Build job-ready skills with Haasutech AI." />
<meta name="keywords" content="
AI courses, AI training Noida, AI training Bangalore, learn AI from IITians,
data science courses, data science internship India, machine learning certification,
online AI training India, best AI institute India, Python for AI,
free AI internship, BTech AI internship, AI for students,
job-ready AI skills, industry-led AI bootcamp, AI and ML placement support,
UI UX with React, full stack developer courses India, cloud computing for beginners,
top tech institute in India,Haasutech, Haasutech AI, No.1 AI institute, tech career switch
" />

    <meta property="og:title" content="Haasutech AI - Learn AI from IITians" />
    <meta property="og:description" content="Join courses crafted by top IIT graduates and professionals." />
    <meta property="og:image" content="/ai-og.png" />
    <meta name="google-site-verification" content="6FG4xXrv6XD7Xe-YSBf5HArEdUzaZou3UAzc0Ojud_A" />

    <!-- 👇 JSON-LD Structured Review -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Review",
        "author": "Aarav Mehta",
        "reviewBody": "Haasutech AI gave me real industry-level knowledge in ML.",
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": "5"
        },
        "itemReviewed": {
          "@type": "Organization",
          "name": "Haasutech",
           "sameAs": "https://haasutech.in"
        }
      }
    </script>
  </Fragment>

  <!-- Page Content -->
  <HomePage client:load />
</MainLayout>
